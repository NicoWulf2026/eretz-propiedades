# ===== ERETZ Propiedades — variables de entorno (ejemplo, sin valores reales) =====
# Copiar a .env y completar con valores reales. NO commitear .env (gitignored).

# Supabase (producción / frontend)
SUPABASE_URL=https://<tu-proyecto>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_ANON_KEY=your_public_anon_key_here
SUPABASE_TABLE=propiedades

# Conexión Postgres directa a Supabase (para DDL / operaciones internas del pipeline)
SUPABASE_DATABASE_URL=postgresql://<user>:<password>@db.<tu-proyecto>.supabase.co:5432/postgres

# ===== Base interna del pipeline de scraping =====
# Cutover (2026-06): el pipeline interno usa Supabase, schema internal_scraping.
USE_INTERNAL_DB=true
# INTERNAL_DB_URL apunta a la base interna activa (= SUPABASE_DATABASE_URL tras el cutover).
INTERNAL_DB_URL=postgresql://<user>:<password>@db.<tu-proyecto>.supabase.co:5432/postgres
# Schema donde viven las tablas del pipeline: "internal_scraping" (Supabase) o "public" (Neon legacy).
INTERNAL_DB_SCHEMA=internal_scraping

# Neon: backup congelado, NO usado por el pipeline tras el cutover. No borrar.
NEON_DB_URL_BACKUP=postgresql://<user>:<password>@<host>.neon.tech/neondb?sslmode=require
