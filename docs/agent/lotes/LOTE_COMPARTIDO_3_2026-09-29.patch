+        return False
+    if ultimos[0].get("motivo") != "PAGINA_CONTENEDORA_REQUIERE_REVISION":
+        return False
+    partes = urllib.parse.urlparse(url)
+    return not any(ch.isdigit() for ch in partes.path + partes.query)
