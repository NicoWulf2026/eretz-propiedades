# Conexión PostgreSQL exclusiva del servidor. Debe usar un usuario de solo lectura.
# Nunca usar prefijo NEXT_PUBLIC_ ni copiar este valor al navegador.
SUPABASE_DATABASE_URL=

# Gate local read-only. El CSV debe quedar fuera de public/ y fuera de Git.
ERETZ_PREVIEW_QUALITY_GATE=false
ERETZ_PREVIEW_GATE_ASSIGNMENTS_PATH=

# URL canónica futura, sin barra final.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Phase A es fail-closed: no existe una variable que habilite indexación.
