# Preferir estas variables server-only para que el navegador no reciba el endpoint ni la clave anon.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Compatibilidad local heredada (no configurar en el preview privado si se usan las anteriores).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Gate local read-only. El CSV debe quedar fuera de public/ y fuera de Git.
ERETZ_PREVIEW_QUALITY_GATE=false
ERETZ_PREVIEW_GATE_ASSIGNMENTS_PATH=

# URL canónica futura, sin barra final.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Beta: mantener false. Cambiar solo durante un lanzamiento público autorizado.
NEXT_PUBLIC_SITE_INDEXING=false
