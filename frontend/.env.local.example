# Conexión PostgreSQL exclusiva del servidor. Debe usar un usuario de solo lectura.
# Nunca usar prefijo NEXT_PUBLIC_ ni copiar este valor al navegador.
SUPABASE_DATABASE_URL=

# Gate fail-closed. Elegir una sola fuente privada: archivo local o Blob en Preview.
ERETZ_PREVIEW_QUALITY_GATE=false
ERETZ_PREVIEW_GATE_ASSIGNMENTS_PATH=
ERETZ_PREVIEW_GATE_BLOB_PATHNAME=
ERETZ_PREVIEW_GATE_SHA256=
ERETZ_PREVIEW_GATE_FINGERPRINT=

# Vercel Blob privado. Es sensible y nunca debe llevar prefijo NEXT_PUBLIC_.
BLOB_READ_WRITE_TOKEN=

# URL canónica futura, sin barra final.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Phase A es fail-closed: no existe una variable que habilite indexación.
